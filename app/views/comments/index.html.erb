<p style="color: green"><%= notice %></p>

<h1>Comments</h1>

<div id="comments">
  <% @comments.each do |comment| %>
    <%= render comment %>
    <p>
      <%= link_to "Show this comment", quote_comment_path(@quote, comment) %> <!-- Updated link -->
    </p>
  <% end %>
</div>

<%= link_to "New comment", new_quote_comment_path(@quote) %> <!-- Updated link to new comment -->
