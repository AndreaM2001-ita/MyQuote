<p style="color: green"><%= notice %></p>

<%= render @comment %>

<div>
  <%= link_to "Back to comments", quote_comments_path(@quote) %> 

  <% if current_user && current_user.id == @comment.user.id %>
    <%= button_to "Destroy this comment", quote_comment_path(@quote, @comment), method: :delete, data: { confirm: "Are you sure you want to delete this comment?" } %>
  <% end %>
</div>
