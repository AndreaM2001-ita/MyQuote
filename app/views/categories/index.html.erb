<p style="color: green"><%= notice %></p>

<h1>Categories</h1>

<div id="categories">
  <% if @categories.any? %>
    <ul>
      <% @categories.each do |category| %>
        <li class="d-flex justify-content-between align-items-center">
          <strong><%= link_to category.catName, category_path(category) %></strong>
          <%= link_to 'Delete', category, method: :delete, data: { confirm: 'Are you sure you want to delete this category?' }, class: 'btn btn-danger btn-sm ms-auto' %>
        </li>
        <hr>
      <% end %>
    </ul>
  <% else %>
    <p>No categories available.</p>
  <% end %>
</div>

<div>
  <%= link_to "New Category", new_category_path, class: "btn btn-success" %>
</div>
