<div id="<%= dom_id philosopher %>" class="philosopher-details" style="border: 1px solid #ddd; padding: 15px; margin-bottom: 20px; border-radius: 5px; background-color: #f9f9f9;">
  <h4><%= philosopher.firstName %> <%= philosopher.lastName %></h4>

  <p>
    <strong>Birth Year:</strong>
    <%= philosopher.birthYear.present? ? philosopher.birthYear : 'N/A' %>
  </p>

  <p>
    <strong>Death Year:</strong>
    <%= philosopher.deathYear.present? ? philosopher.deathYear : 'N/A' %>
  </p>

  <p>
    <strong>Biography:</strong>
    <%= philosopher.biography.present? ? philosopher.biography : 'Biography not available.' %>
  </p>
</div>