<div id="<%= dom_id user %>" class="my-4 border rounded p-4 shadow">
  <h3 class="mb-4">User Profile</h3>

  <div class="mb-3">
    <label class="form-label">First Name:</label>
    <div class="fw-bold"><%= user.firstName %></div>
  </div>
  
  <div class="mb-3">
    <label class="form-label">Last Name:</label>
    <div class="fw-bold"><%= user.lastName %></div>
  </div>
  
  <div class="mb-3">
    <label class="form-label">Email:</label>
    <div class="fw-bold"><%= user.email %></div>
  </div>

  <% if logged_in? && is_administrator? %>
    <div class="mb-3">
      <label class="form-label">Current Password:</label>
      <div class="text-danger fw-bold">ENCRYPTED</div>
    </div>
  
    <div class="mb-3">
      <label class="form-label">Account Type:</label>
      <div class="fw-bold">
        <% if user.is_admin %>
          <span class="badge bg-success">Administrator</span>
        <% else %>
          <span class="badge bg-primary">Standard User</span>
        <% end %>
      </div>
    </div>
  
    <div class="mb-3">
      <label class="form-label">Status:</label>
      <div class="fw-bold"><%= user.status %></div>
    </div>
  <% end %>
</div>
